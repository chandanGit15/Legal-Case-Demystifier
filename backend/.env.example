[TEMPLATE]
# Copy to .env and fill in. Secrets never reach the frontend.

# Gemini API (empty = demo mode with clearly-labeled sample analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Database: SQLite by default; PostgreSQL later via
# DATABASE_URL=postgresql://user:pass@host:5432/lcd
# DATABASE_URL=

# Auth — REQUIRED in production. The development default is insecure.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=168

# Browser origins allowed to call the API cross-origin (comma separated).
# Same-origin / proxied requests are not affected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
MAX_UPLOAD_MB=20

# Rate limits (per IP per hour, in-memory)
RATE_LIMIT_AUTH_PER_HOUR=40
RATE_LIMIT_DEMO_PER_HOUR=25

# Server
PORT=5000
